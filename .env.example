# 蜂巢凭据（凭据代理原则：key 只进 .env，经内核/连接器注入，绝不进 bot prompt、绝不进代码）

# ---- 引擎（@hive/adapters，见 docs/引擎清单.md）----
DEEPSEEK_API_KEY=

# ---- 飞书连接器（@hive/connectors）----
# https://open.feishu.cn → 开发者后台 → 创建企业自建应用
# 事件订阅：订阅 im.message.receive_v1；权限：im:message、im:message:send_as_bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅页设置的 Encrypt Key（加密+验签；不设则回调不加密）
FEISHU_ENCRYPT_KEY=
# 每条聊天消息的默认任务预算（$）
FEISHU_DEFAULT_BUDGET_USD=3

# ---- Telegram 备胎通道（@hive/connectors；飞书未就绪时的开发期主通道）----
# 1. Telegram 找 @BotFather → /newbot → 拿 token
# 2. 私聊/拉群后填：TELEGRAM_BOT_TOKEN=<token>
# 3. 跑 packages/connectors/examples/telegram-demo.mjs（长轮询免公网）
TELEGRAM_BOT_TOKEN=

# 3. Slack（V1.0 第 4 套通道，Socket Mode 免公网）：api.slack.com/apps 建应用
#    Socket Mode 启用拿 xapp-（SLACK_APP_TOKEN）+ OAuth 拿 xoxb-（SLACK_BOT_TOKEN，scopes: chat:write）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# 4. 钉钉（V1.0 第 5 套通道，Stream Mode 免公网）：open-dev.dingtalk.com 企业内部应用
#    机器人能力开启 + 消息接收模式选 Stream 模式；robotCode = appKey
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 5. 企业微信（V1.0 第 6 套通道，回调模式需公网 URL，如 cloudflared 转发）
#    work.weixin.qq.com 应用管理 → 自建应用：AgentId + Secret；接收消息 API：Token + EncodingAESKey
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
