{
  "adapter": "groq",
  "kind": "api",
  "mode": "openai_chat",
  "contract_version": 1,
  "usage_parse": {
    "tokens_in": "$.usage.prompt_tokens",
    "tokens_out": "$.usage.completion_tokens"
  },
  "on_unparseable": "fail",
  "timeout_ms": 120000,
  "caps": {
    "tools": true
  },
  "base_url": "https://api.groq.com/openai/v1",
  "model": "llama-3.3-70b-versatile",
  "env_key": "GROQ_API_KEY",
  "pricing": {
    "input_per_mtok": 0.59,
    "output_per_mtok": 0.79
  },
  "tier": "T2",
  "notes": "Groq 极速推理（Llama 系）；pricing 牌价粗估。"
}
