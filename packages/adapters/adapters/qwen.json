{
  "adapter": "qwen",
  "kind": "api",
  "mode": "openai_chat",
  "contract_version": 1,
  "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
  "model": "qwen-plus",
  "env_key": "DASHSCOPE_API_KEY",
  "usage_parse": {
    "tokens_in": "$.usage.prompt_tokens",
    "tokens_out": "$.usage.completion_tokens"
  },
  "pricing": {
    "input_per_mtok": 0.11,
    "output_per_mtok": 0.28
  },
  "on_unparseable": "fail",
  "timeout_ms": 120000,
  "caps": {
    "tools": true
  },
  "tier": "T1",
  "notes": "openai 兼容端点 dashscope.aliyuncs.com/compatible-mode/v1，模型 qwen-plus；pricing 为牌价粗估（¥0.8/M 入、¥2/M 出折算），实际以账单为准；2026-11-11 起启用 response_format json_object（API 级强制合法 JSON，合规率加固；探针实证 HTTP 200）。key 从阿里云百炼控制台获取（DASHSCOPE_API_KEY）",
  "extra_body": {
    "response_format": {
      "type": "json_object"
    }
  }
}
