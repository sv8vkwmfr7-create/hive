{
  "schema_version": 1,
  "team": "fake-engine-team",
  "roles": [
    {
      "id": "chief",
      "name": "总管",
      "kind": "orchestrator",
      "engine": { "type": "cli", "adapter": "fake-codex" },
      "profile": "profiles/总管.md",
      "guards": { "can_initiate_mention": true, "daily_budget_usd": 10, "max_turns": 30 }
    },
    {
      "id": "researcher",
      "name": "研究员",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "fake-deepseek", "model": "deepseek-chat" },
      "profile": "profiles/研究员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 5 }
    },
    {
      "id": "writer",
      "name": "写手",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "fake-deepseek", "model": "deepseek-chat" },
      "profile": "profiles/写手.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 5 }
    },
    {
      "id": "reviewer",
      "name": "审核员",
      "kind": "reviewer",
      "engine": { "type": "cli", "adapter": "fake-codex" },
      "profile": "profiles/审核员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 5 }
    }
  ],
  "handoffs": [
    { "from": "chief", "to": "researcher", "when": "任务含调研子项" },
    { "from": "chief", "to": "writer", "when": "素材齐备，进入成稿" },
    { "from": "researcher", "to": "writer", "when": "素材产出完成" },
    { "from": "writer", "to": "reviewer", "when": "初稿完成" }
  ]
}
