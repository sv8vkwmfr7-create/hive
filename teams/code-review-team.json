{
  "schema_version": 1,
  "team": "code-review-team",
  "_comment": "原创模板：代码评审队——功能审查 + 安全审查双专业岗，结论汇总后独立审核。",
  "roles": [
    {
      "id": "chief",
      "name": "总管",
      "kind": "orchestrator",
      "engine": { "type": "api", "adapter": "deepseek", "model": "deepseek-chat" },
      "profile": "profiles/总管.md",
      "guards": { "can_initiate_mention": true, "daily_budget_usd": 5, "max_turns": 30 }
    },
    {
      "id": "code-specialist",
      "name": "代码审查员",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "deepseek", "model": "deepseek-chat" },
      "profile": "profiles/研究员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 2 }
    },
    {
      "id": "security-specialist",
      "name": "安全审查员",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "qwen", "model": "qwen-plus" },
      "profile": "profiles/研究员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 2 }
    },
    {
      "id": "reviewer",
      "name": "评审长",
      "kind": "reviewer",
      "engine": { "type": "api", "adapter": "deepseek", "model": "deepseek-chat" },
      "profile": "profiles/审核员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 1 }
    }
  ],
  "handoffs": [
    { "from": "chief", "to": "code-specialist", "when": "需要代码质量审查" },
    { "from": "chief", "to": "security-specialist", "when": "需要安全面审查" },
    { "from": "code-specialist", "to": "reviewer", "when": "代码审查意见完成" },
    { "from": "security-specialist", "to": "reviewer", "when": "安全审查意见完成" }
  ]
}
