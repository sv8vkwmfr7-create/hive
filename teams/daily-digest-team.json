{
  "schema_version": 1,
  "team": "daily-digest-team",
  "_comment": "原创模板：每日简报队——采集 → 摘编 → 发布（publish 的 send_external 过审批门：CEO 手机拍板后才外发）。",
  "roles": [
    {
      "id": "chief",
      "name": "总管",
      "kind": "orchestrator",
      "engine": { "type": "api", "adapter": "deepseek", "model": "deepseek-chat" },
      "profile": "profiles/总管.md",
      "guards": { "can_initiate_mention": true, "daily_budget_usd": 5, "max_turns": 30 }
    },
    {
      "id": "collector",
      "name": "采集员",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "qwen", "model": "qwen-plus" },
      "profile": "profiles/研究员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 2 }
    },
    {
      "id": "summarizer",
      "name": "摘要师",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "deepseek", "model": "deepseek-chat" },
      "profile": "profiles/写手.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 2 }
    },
    {
      "id": "publisher",
      "name": "发布员",
      "kind": "specialist",
      "engine": { "type": "api", "adapter": "deepseek", "model": "deepseek-chat" },
      "profile": "profiles/写手.md",
      "guards": { "can_initiate_mention": false, "needs_approval_for": ["send_external"], "max_turns": 20, "daily_budget_usd": 2 }
    },
    {
      "id": "reviewer",
      "name": "审核员",
      "kind": "reviewer",
      "engine": { "type": "api", "adapter": "qwen", "model": "qwen-plus" },
      "profile": "profiles/审核员.md",
      "guards": { "can_initiate_mention": false, "max_turns": 20, "daily_budget_usd": 1 }
    }
  ],
  "handoffs": [
    { "from": "chief", "to": "collector", "when": "采集今日信息" },
    { "from": "collector", "to": "summarizer", "when": "原始素材采集完成" },
    { "from": "summarizer", "to": "publisher", "when": "摘要定稿" },
    { "from": "publisher", "to": "reviewer", "when": "发布稿就绪" }
  ]
}
